# External Product Intelligence Graph — environment template.
# Copy to .env and fill in real values. NEVER commit .env (see .gitignore).

# --- Scraping / enrichment (Phase 1+ only; unused during Phase 0) ---
APIFY_TOKEN=

# --- LLM provider (one is required for Phase 8 normalization/scoring) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Optional search provider ---
SERP_API_KEY=

# --- Database ---
# Defaults to local SQLite if unset. A Supabase/Postgres URL can be supplied
# for the production storage path (see docs/scaling_and_cost_model.md).
DATABASE_URL=sqlite:///data/processed/epig.db
